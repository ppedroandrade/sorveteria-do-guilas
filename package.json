{
  "name": "gelateria-gestao",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão para sorveteria artesanal",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
