// Modelo de dados — Sistema de gestão para gelateria artesanal
//
// Convenções:
// - Valores monetários: inteiros em centavos (sufixo "Cents").
// - Quantidades de estoque: inteiros em milésimos da unidade (sufixo "Milli"),
//   ex.: 1,5 litro = 1500. Evita erros de ponto flutuante.
// - Registros com histórico comercial não são apagados: são desativados (active/deletedAt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Autenticação ─────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
}

model Session {
  // SHA-256 do token aleatório guardado no cookie (o token em si nunca é salvo).
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────────── Configurações ─────────────────────────────

model BusinessSettings {
  id                      Int      @id @default(1)
  businessName            String   @default("Minha Gelateria")
  logoDataUrl             String?
  phone                   String?
  address                 String?
  currency                String   @default("BRL")
  timezone                String   @default("America/Sao_Paulo")
  defaultDeliveryFeeCents Int      @default(0)
  receiptHeader           String?
  receiptFooter           String?
  updatedAt               DateTime @updatedAt
}

// Apresentações globais (ex.: "Tamanho 1"). Renomear aqui altera todos os produtos
// que não possuem um nome próprio para a variante.
model Presentation {
  id          String           @id @default(cuid())
  name        String
  description String?
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

// ───────────────────────────── Catálogo ─────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  imageDataUrl       String?
  categoryId         String?
  isVegan            Boolean             @default(false)
  isAvailable        Boolean             @default(true) // disponível para venda agora
  active             Boolean             @default(true) // false = desativado (soft delete)
  trackStock         Boolean             @default(false)
  stockUnit          String? // ex.: "litro", "kg", "pote", "unidade"
  stockMilli         Int                 @default(0)
  minStockMilli      Int                 @default(0)
  allowNegativeStock Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  orderItems         OrderItem[]
  movements          InventoryMovement[]

  @@index([active, isAvailable])
  @@index([categoryId])
  @@index([name])
}

model ProductVariant {
  id                    String        @id @default(cuid())
  productId             String
  presentationId        String?
  customName            String? // nome próprio neste produto (sobrepõe a apresentação global)
  priceCents            Int
  // Quanto do estoque do produto (na unidade do produto, em milésimos) cada unidade
  // vendida consome. Obrigatório apenas quando o produto controla estoque.
  stockConsumptionMilli Int?
  active                Boolean       @default(true)
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  presentation          Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]

  @@index([productId])
  @@index([presentationId])
}

// ───────────────────────────── Clientes ─────────────────────────────

model Customer {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  phoneDigits  String? // apenas dígitos, para busca
  email        String?
  address      String?
  neighborhood String?
  city         String?
  notes        String?
  preferences  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]

  @@index([name])
  @@index([phoneDigits])
  @@index([deletedAt])
}

// ───────────────────────────── Pedidos ─────────────────────────────

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

model Order {
  id                     String               @id @default(cuid())
  number                 Int                  @unique @default(autoincrement())
  customerId             String?
  status                 OrderStatus          @default(PENDING)
  paymentStatus          PaymentStatus        @default(PENDING)
  fulfillment            FulfillmentType      @default(PICKUP)
  deliveryAddress        String?
  scheduledFor           DateTime?
  discountType           DiscountType?
  discountValue          Int                  @default(0) // centavos (AMOUNT) ou pontos-base (PERCENT: 1000 = 10%)
  subtotalCents          Int
  discountCents          Int                  @default(0)
  deliveryFeeCents       Int                  @default(0)
  totalCents             Int
  paidCents              Int                  @default(0) // líquido (pagamentos − reembolsos), mantido em transação
  preferredPaymentMethod PaymentMethod?
  notes                  String?
  cancelReason           String?
  cancelledAt            DateTime?
  completedAt            DateTime?
  idempotencyKey         String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  customer               Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  payments               Payment[]
  movements              InventoryMovement[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                    String         @id @default(cuid())
  orderId               String
  productId             String
  variantId             String
  // Fotografia do momento da venda — não muda se o catálogo mudar depois.
  productName           String
  variantName           String
  unitPriceCents        Int
  quantity              Int
  totalCents            Int
  stockConsumptionMilli Int? // consumo por unidade aplicado nesta venda
  notes                 String?
  createdAt             DateTime       @default(now())
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant               ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  kind           PaymentKind   @default(PAYMENT)
  method         PaymentMethod
  amountCents    Int // sempre positivo; o sentido vem de "kind"
  paidAt         DateTime      @default(now())
  notes          String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paidAt])
  @@index([method])
}

// ───────────────────────────── Estoque ─────────────────────────────

enum InventoryMovementType {
  IN // entrada
  OUT // saída manual (perda, consumo, degustação…)
  ADJUSTMENT // ajuste de contagem
  SALE // baixa automática por pedido
  SALE_REVERSAL // estorno de baixa (cancelamento/edição de pedido)
}

model InventoryMovement {
  id                String                @id @default(cuid())
  productId         String
  type              InventoryMovementType
  quantityMilli     Int // variação com sinal (+ entra, − sai)
  balanceAfterMilli Int
  orderId           String?
  reason            String?
  createdAt         DateTime              @default(now())
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId, productId])
}
