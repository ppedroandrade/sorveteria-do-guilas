# Conexão principal (em produção, use a URL com pooling do provedor: Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gelateria?schema=public"
# Conexão direta (sem pooler) usada pelas migrations. Localmente pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gelateria?schema=public"

# Banco exclusivo para testes de integração (será limpo a cada execução!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gelateria_test?schema=public"

# Conta do proprietário criada pelo seed (login por nome de usuário, sem diferenciar maiúsculas)
ADMIN_NAME="Guilas"
ADMIN_LOGIN="Guilas"
ADMIN_PASSWORD="Senha123"

# Cookie de sessão. "lax" (padrão) para acesso direto; "none" para funcionar dentro
# de iframe (ex.: página do Hugging Face Spaces) — exige HTTPS.
# SESSION_COOKIE_SAMESITE="lax"